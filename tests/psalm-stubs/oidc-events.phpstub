<?php

declare(strict_types=1);

/**
 * Psalm stubs for the IdP-app events Astrolabe dispatches: the `oidc` app's
 * (Nextcloud as identity provider) and `user_oidc`'s (Nextcloud as a client of
 * an external identity provider, GH #324).
 *
 * Neither app is a Composer/static-analysis dependency, so Psalm cannot see
 * these classes and would otherwise infer `mixed` for the events and their
 * return values. These stubs give Psalm the real shapes used by McpTokenMinter.
 */

namespace OCA\OIDCIdentityProvider\Event;

use OCP\EventDispatcher\Event;

class TokenGenerationRequestEvent extends Event {
	public function __construct(
		string $clientIdentifier,
		string $userId,
		string $extraScopes = '',
		string $resource = '',
	) {
	}

	public function getClientIdentifier(): string {
	}

	public function getUserId(): string {
	}

	public function getExtraScopes(): string {
	}

	public function getResource(): ?string {
	}

	public function getAccessToken(): ?string {
	}

	public function setAccessToken(string $accessToken): void {
	}

	public function getExpiresIn(): ?int {
	}

	public function setExpiresIn(?int $expiresIn): void {
	}
}

namespace OCA\UserOIDC\Model;

class Token {
	public function getAccessToken(): string {
	}

	public function getIdToken(): ?string {
	}

	public function getExpiresIn(): int {
	}

	public function isExpired(): bool {
	}
}

namespace OCA\UserOIDC\Event;

use OCA\UserOIDC\Model\Token;
use OCP\EventDispatcher\Event;

class ExchangedTokenRequestedEvent extends Event {
	/** @param list<string> $extraScopes */
	public function __construct(
		string $targetAudience,
		array $extraScopes = [],
	) {
	}

	public function getTargetAudience(): string {
	}

	/** @return list<string> */
	public function getExtraScopes(): array {
	}

	public function getToken(): ?Token {
	}

	public function setToken(?Token $token): void {
	}
}

class ExternalTokenRequestedEvent extends Event {
	public function __construct() {
	}

	public function getToken(): ?Token {
	}

	public function setToken(?Token $token): void {
	}
}
