{
  "name": "astrolabe",
  "version": "0.52.3",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^26.0.0",
    "npm": "^12.0.0"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.reference.config.js && vite build -c vite.settings.config.js",
    "dev": "vite --mode development build && vite --mode development build -c vite.settings.config.js",
    "watch": "vite --mode development build --watch",
    "watch:settings": "vite --mode development build --watch -c vite.settings.config.js",
    "lint": "eslint src",
    "stylelint": "stylelint 'src/**/*.vue' 'src/**/*.scss' 'src/**/*.css'",
    "test:unit": "node --test 'src/**/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:external-idp": "playwright test --config playwright.external-idp.config.ts"
  },
  "type": "module",
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/dialogs": "^7.2.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.3.3",
    "markdown-it": "^15.0.0",
    "pdfjs-dist": "^6.0.0",
    "plotly.js-dist-min": "^4.0.0",
    "vue": "^3.0.0",
    "vue-material-design-icons": "^5.3.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "3.1.2",
    "@nextcloud/eslint-config": "9.0.1",
    "@nextcloud/stylelint-config": "3.2.2",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "sass-embedded": "1.108.2",
    "stylelint": "17.16.0",
    "terser": "5.51.4",
    "vite": "8.3.8"
  }
}
