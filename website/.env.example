# website/ — Astrolabe Cloud marketing site (static, GitHub Pages, astrolabecloud.com)
#
# Marketing-only: no auth, no control-plane dependency. Sign-in lives on the
# portal deploy (astrolabe-cloud-website apps/web, app.<env>.astrolabecloud.com),
# so the only config the landing needs is the portal origin to link to.
#
# This is baked into the static export at build time, so it's set in the Pages
# workflow (.github/workflows/landing-pages.yml), not read at runtime.

# Origin of the authenticated portal. "Sign in" links point at
# `${NEXT_PUBLIC_PORTAL_URL}/api/auth/signin` (NEXT_PUBLIC_ → inlined at build).
#   Local dev:  http://localhost:3000          (apps/web `npm run dev`)
#   Now:        https://app.dev.astrolabecloud.com   (dev portal; what the workflow sets)
#   Prod:       https://app.astrolabecloud.com       (flip at production launch)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
